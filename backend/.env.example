# ==============================================================================
# Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ==============================================================================

# ==============================================================================
# Django Settings
# ==============================================================================

# Django secret key - generate a new one for production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production

# Debug mode - set to False in production
DJANGO_DEBUG=True

# Allowed hosts (comma-separated) - set in production
# Example: ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Redis Configuration
# ==============================================================================

# Redis host - use 'localhost' for local dev, 'redis' for Docker
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Celery broker/result backend
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==============================================================================
# Angel One API Credentials
# ==============================================================================
# Get these from Angel One SmartAPI portal:
# https://smartapi.angelbroking.com/

# API Key - provided by Angel One when you register for SmartAPI
ANGEL_ONE_API_KEY=d7JhZUoA

# Client ID - your Angel One trading account client ID
ANGEL_ONE_CLIENT_ID=AACH163369

# Password - your Angel One account password (PIN)
ANGEL_ONE_PASSWORD=0418

# TOTP Secret - scan QR code in Angel One app to get this
# This is used to generate TOTP codes for 2FA
ANGEL_ONE_TOTP_SECRET=JEXTRAOV3R5GHQITY32XQWYCKU

# Optional service user id (Django user id) to load encrypted credentials
ANGEL_ONE_SERVICE_USER_ID=

# Encryption key for storing credentials (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ==============================================================================
# CORS Settings (for production)
# ==============================================================================

# Frontend URL(s) allowed to make requests (comma-separated)
# Example: CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Market Data Settings
# ==============================================================================

# Update interval for market breadth in seconds
MARKET_BREADTH_UPDATE_INTERVAL=2

# Disable auto-start of market data service
# Set to 'true' for testing or running migrations
DISABLE_MARKET_DATA_AUTOSTART=false

# ==============================================================================
# Database Settings (for production with PostgreSQL)
# ==============================================================================

DB_NAME=stock_platform
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Set to true to use SQLite for local dev
USE_SQLITE=true

# ============================================================================== 
# Stock Data Pipeline Settings
# ==============================================================================

# JSON array with symbol config: [{"symbol":"RELIANCE","token":"2885","exchange":"NSE"}]
STOCK_TOKEN_MAP=

# Polling interval in seconds
STOCK_POLL_INTERVAL_SECONDS=60

# Cache TTL for latest prices
STOCK_LATEST_CACHE_TTL=120

# Redis lock timeout for pipeline
STOCK_PIPELINE_LOCK_TIMEOUT=55

# ==============================================================================
# Logging
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
